# ─── Pinata IPFS ───────────────────────────────────────────────────────────────
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
PINATA_JWT=

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Session / Storage ─────────────────────────────────────────────────────────
# How long to keep session files on disk (hours)
SESSION_TTL_HOURS=1

# Temporary sessions directory (default: /tmp/soundmint-sessions)
SESSIONS_DIR=/tmp/soundmint-sessions

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
# Max upload requests per IP per hour
RATE_LIMIT_UPLOADS_PER_HOUR=10

# ─── Generation ────────────────────────────────────────────────────────────────
# GIF dimensions (px)
GIF_WIDTH=600
GIF_HEIGHT=600

# Minimum GIF frames to capture
GIF_FRAMES=72

# Frames per second for GIF
GIF_FPS=12
